    {
      "category": [
        "Building blocks",
        "Files"
      ],
      "description": "The files in a folder whose names match the pattern (*.png, *.jpg: * and ?, case ignored; several separated by commas), sorted, optionally in its subfolders too. Wire it into a node's file input to run that node once per file, each result labelled with the file's name.",
      "display": "Find Files",
      "id": "file.find",
      "inputs": [
        {
          "default": "",
          "name": "folder",
          "path": {
            "filters": [],
            "mode": "dir"
          },
          "tooltip": "The folder to search",
          "type": "STRING"
        },
        {
          "default": "*",
          "name": "pattern",
          "tooltip": "File names to match: * and ?, several separated by commas (*.png, *.jpg)",
          "type": "STRING"
        },
        {
          "default": false,
          "name": "recursive",
          "tooltip": "Search the subfolders too",
          "type": "BOOL"
        }
      ],
      "outputs": [
        {
          "list": true,
          "name": "files",
          "socket": "socket",
          "type": "STRING"
        }
      ]
    },
    {
      "category": [
        "Building blocks",
        "Files"
      ],
      "description": "Read a file into a value: an image, an SVG, a PDF or any bytes, its media type from its extension. Given a list of files (Find Files, Select Files), it reads each, so wiring its value into, say, an app's Open image input opens every file.",
      "display": "Load Files",
      "id": "file.load",
      "inputs": [
        {
          "default": "",
          "name": "file",
          "path": {
            "filters": [
              {
                "extensions": [],
                "name": "Any file"
              }
            ],
            "mode": "open"
          },
          "socket": "both",
          "tooltip": "The file to read; wire Find Files or Select Files to read each",
          "type": "STRING"
        }
      ],
      "outputs": [
        {
          "name": "value",
          "socket": "socket",
          "type": "ANY"
        }
      ]
    },
    {
      "category": [
        "Building blocks",
        "Files"
      ],
      "description": "The files chosen with \u2026 (several at once), as a list: wire it into a node's file input to run that node once per file, each result labelled with the file's name.",
      "display": "Select Files",
      "id": "file.select",
      "inputs": [
        {
          "default": "",
          "name": "files",
          "path": {
            "filters": [],
            "mode": "files"
          },
          "tooltip": "The files, one path per line: choose them with \u2026",
