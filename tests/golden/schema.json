  "nodes": [
    {
      "category": [
        "Atlas"
      ],
      "description": "Add two numbers. Widgets that can also be wired, with a range the engine enforces.",
      "display": "Add",
      "family": "atlas",
      "id": "atlas.add",
      "inputs": [
        {
          "default": 1.0,
          "max": 1000000000.0,
          "min": -1000000000.0,
          "name": "a",
          "type": "FLOAT"
        },
        {
          "default": 2.0,
          "label": "Plus",
          "max": 1000000000.0,
          "min": -1000000000.0,
          "name": "b",
          "tooltip": "Added to a",
          "type": "FLOAT"
        }
      ],
      "outputs": [
        {
          "name": "float",
          "type": "FLOAT"
        }
      ]
    },
