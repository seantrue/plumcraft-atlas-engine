        }
      ],
      "outputs": [
        {
          "list": true,
          "name": "files",
          "socket": "socket",
          "type": "STRING"
        }
      ]
    },
    {
      "category": [
        "Building blocks",
        "Files"
      ],
      "description": "Write values into a folder: each file is named from basename and what made the value (trace_corgi_colors-8.svg: the file it came from and the settings varied), with its type's extension. A different file already there is an error unless overwrite is on.",
      "display": "Write Files",
      "flags": {
        "input_list": true,
        "output_node": true
      },
      "id": "file.write",
      "inputs": [
        {
          "name": "values",
          "socket": "socket",
          "tooltip": "The values to write: one, or a list",
          "type": "ANY"
        },
        {
          "default": "",
          "name": "folder",
          "path": {
            "filters": [],
            "mode": "dir"
          },
          "tooltip": "The folder to write into (made when missing)",
          "type": "STRING"
        },
        {
          "default": "out",
          "name": "basename",
          "tooltip": "The start of every file name; what varied follows it",
          "type": "STRING"
        },
        {
          "default": false,
          "name": "overwrite",
          "tooltip": "Replace files that are already there",
          "type": "BOOL"
        }
      ],
      "memo": {
        "scope": "none"
      },
      "outputs": [
        {
          "list": true,
          "name": "files",
          "socket": "socket",
          "type": "STRING"
        }
      ]
    },
